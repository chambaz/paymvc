{
  "name": "@paymvc/solana-anchor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check . && cargo fmt --check && tsx scripts/validate-manifest.ts",
    "format": "prettier --write . && cargo fmt",
    "test": "cargo test --locked && vitest run",
    "test:e2e": "playwright test",
    "test:conformance": "node ../../../conformance/verify.mjs",
    "test:live": "tsx scripts/live.ts",
    "test:live:browser": "tsx scripts/live-browser.ts",
    "contracts:build": "anchor build --ignore-keys --tools-version v1.57 && tsx scripts/generate-client.ts",
    "deploy": "tsx scripts/deploy.ts",
    "local": "tsx scripts/local.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.8.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "ajv": "8.20.0",
    "codama": "1.11.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
